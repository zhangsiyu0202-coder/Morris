FROM node:22-alpine

WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web

RUN pnpm install --frozen-lockfile

COPY apps/functions ./apps/functions

# The development checkout links apps/web/.env.local to the repo-root .env.
# Docker deliberately excludes that secret file, so remove the dangling link
# and inject only the public build-time settings below.
RUN rm -f apps/web/.env.local

# Workspace packages publish compiled entry points. Build the packages consumed
# by Next.js inside the image instead of relying on a developer's local dist/.
RUN pnpm --filter @merism/contracts build \
 && pnpm --filter @merism/llm build \
 && pnpm --filter @merism/observability build

ARG NEXT_PUBLIC_APPWRITE_ENDPOINT
ARG NEXT_PUBLIC_APPWRITE_PROJECT_ID
ARG NEXT_PUBLIC_ISSUE_TOKEN_FUNCTION_ID
ENV NEXT_PUBLIC_APPWRITE_ENDPOINT=$NEXT_PUBLIC_APPWRITE_ENDPOINT
ENV NEXT_PUBLIC_APPWRITE_PROJECT_ID=$NEXT_PUBLIC_APPWRITE_PROJECT_ID
ENV NEXT_PUBLIC_ISSUE_TOKEN_FUNCTION_ID=$NEXT_PUBLIC_ISSUE_TOKEN_FUNCTION_ID

RUN pnpm --filter @merism/web build

ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "--filter", "@merism/web", "start"]
