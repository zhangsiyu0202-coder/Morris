{
  "name": "merism-v2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm -F @merism/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:properties": "vitest run tests/properties",
    "smoke": "bash scripts/smoke.sh",
    "smoke:stress": "tsx scripts/smoke-stress.mts",
    "e2e": "pnpm -F @merism/web e2e",
    "schema:apply": "pnpm -F @merism/appwrite-schema apply",
    "schema:verify": "pnpm -F @merism/appwrite-schema verify",
    "scope-guard": "tsx scripts/scope-guard.ts",
    "semgrep": "semgrep --config .semgrep/rules/ --severity ERROR --error .",
    "semgrep:test": "semgrep --test --config .semgrep/rules/ .semgrep/rules/",
    "semgrep:warn": "semgrep --config .semgrep/rules/ --severity WARNING .",
    "deps:cruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "deps:cruise:report": "depcruise --config .dependency-cruiser.cjs --output-type json apps packages > deps-cruise-report.json",
    "deps:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot apps packages | dot -T svg > docs/architecture/module-graph.svg",
    "test:evals": "tsx tests/evals/harness/runner.ts",
    "stack:up": "bash scripts/stack-up.sh",
    "stack:down": "bash scripts/stack-down.sh",
    "stack:reset": "bash scripts/stack-reset.sh"
  },
  "devDependencies": {
    "@merism/contracts": "workspace:*",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "18.0.0",
    "fast-check": "^3.23.2",
    "livekit-server-sdk": "^2.9.0",
    "node-appwrite": "^14.1.0",
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.25.76"
  }
}
